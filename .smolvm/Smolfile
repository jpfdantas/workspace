cpus    = 4
env = ["TZ=UTC"]
image   = "localhost/dev-sandbox:latest"
memory  = 8192
net = true
net_backend = "virtio-net"
storage = 40
volumes = [".:/workspace", "/var/lib/containers"]
workdir = "/workspace"

[[network.credentials]]
allowed_hosts = [
    "cloudcode-pa.googleapis.com",
    "daily-cloudcode-pa.googleapis.com",
    "generativelanguage.googleapis.com",
    "www.googleapis.com",
]
environment_variable = "AGY_ACCESS_TOKEN"
name = "agy"
set_header = "authorization"

[network]
allow_hosts = [
  "*.docker.io",
  "*.githubusercontent.com",
  "cloudcode-pa.googleapis.com",
  "daily-cloudcode-pa.googleapis.com",
  "deb.debian.org",
  "generativelanguage.googleapis.com",
  "ghcr.io",
  "github.com",
  "oauth2.googleapis.com",
  "quay.io",
  "registry-1.docker.io",
  "security.debian.org",
  "www.googleapis.com",
]
