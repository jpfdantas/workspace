# microVM smolvm. Sem caminhos absolutos nem segredos.
# Construa a imagem a partir de Containerfile (ver README) e rode a partir da RAIZ do repo.
image   = "localhost/dev-sandbox:latest"
workdir = "/workspace"
cpus    = 4
memory  = 8192
storage = 40

env = ["TZ=UTC"]

# Unico mount do host: o projeto. Segundo item e so caminho do guest (disco da VM p/ Podman).
volumes = [".:/workspace", "/var/lib/containers"]

net = true
net_backend = "virtio-net"

# Egress restrito: allowlist minima.
[network]
allow_hosts = [
  "deb.debian.org",
  "security.debian.org",
  "github.com",
  "*.githubusercontent.com",
  "registry-1.docker.io",
  "*.docker.io",
  "ghcr.io",
  "quay.io",
]

# Segredo injetado em runtime a partir do ambiente do host; nunca entra na VM.
[[network.credentials]]
name = "api"
environment_variable = "API_KEY"
allowed_hosts = ["api.example.com"]
set_header = "Authorization"
