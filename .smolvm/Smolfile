# microVM smolvm. Sem caminhos absolutos nem segredos.
# Construa a imagem a partir de .devcontainer/Containerfile (ver README) e rode a partir da RAIZ do repo.
image   = "localhost/dev-sandbox:latest"
workdir = "/workspace"
cpus    = 4
memory  = 8192
storage = 40

env = ["TZ=UTC"]

# Unico mount do host: o projeto. Segundo item e so caminho do guest (disco da VM p/ Podman).
volumes = [".:/workspace", "/var/lib/containers"]

net = true
net_backend = "virtio-net"

# Egress restrito: allowlist minima.
[network]
allow_hosts = [
  "deb.debian.org",
  "security.debian.org",
  "github.com",
  "*.githubusercontent.com",
  "registry-1.docker.io",
  "*.docker.io",
  "ghcr.io",
  "quay.io",
  "cloudcode-pa.googleapis.com",
  "generativelanguage.googleapis.com",
  "oauth2.googleapis.com",
  "daily-cloudcode-pa.googleapis.com",
  "www.googleapis.com",
]

# OAuth do agy: o guest recebe so um placeholder em AGY_ACCESS_TOKEN; o smolvm troca pelo
# valor real (ambiente do host, "Bearer <token>") apenas em HTTPS para os hosts abaixo.
# O valor vem de host-token.sh (nunca persistido).
[[network.credentials]]
name = "agy"
environment_variable = "AGY_ACCESS_TOKEN"
allowed_hosts = ["cloudcode-pa.googleapis.com", "daily-cloudcode-pa.googleapis.com", "www.googleapis.com", "generativelanguage.googleapis.com"]
set_header = "authorization"
