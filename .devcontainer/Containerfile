# Imagem base unica compartilhada por smolvm, Lima e DevPod.
# Tag datada imutavel (para pin por digest: `podman inspect --format '{{.Digest}}'` e troque por @sha256:...).
FROM docker.io/library/debian:trixie-20250929-slim

ARG USERNAME=dev
ARG UID=1000
ARG GID=1000
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq make unzip xz-utils sudo less openssh-client \
      podman uidmap netavark fuse-overlayfs iptables \
    && rm -rf /var/lib/apt/lists/*

# Usuario nao-root (compativel com Docker e Podman rootless).
RUN groupadd --gid "${GID}" "${USERNAME}" \
    && useradd --uid "${UID}" --gid "${GID}" --create-home --shell /bin/bash "${USERNAME}" \
    && mkdir -p /workspace && chown "${UID}:${GID}" /workspace

# Toda a logica de provisionamento vive em setup.sh (idempotente).
COPY .smolvm/setup.sh /usr/local/bin/setup.sh
RUN chmod 0755 /usr/local/bin/setup.sh
USER ${USERNAME}
ENV HOME=/home/${USERNAME}
RUN /usr/local/bin/setup.sh

# Antigravity CLI (agy): instalador oficial -> ~/.local/bin/agy
ENV PATH="${HOME}/.local/bin:${PATH}"
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash \
    && agy --version

WORKDIR /workspace
CMD ["sleep", "infinity"]
